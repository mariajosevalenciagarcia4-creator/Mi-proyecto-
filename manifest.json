// REGISTRAR PWA

if ("serviceWorker" in navigator) {

    window.addEventListener("load", () => {

            navigator.serviceWorker
                        .register("./sw.js")
                                    .then(() => {
                                                    console.log("PWA instalada correctamente");
                                                                })
                                                                            .catch((error) => {
                                                                                            console.log("Error:", error);
                                                                                                        });

                                                                                                            });

                                                                                                            }